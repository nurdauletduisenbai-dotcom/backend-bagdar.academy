# Django General Settings
DJANGO_SECRET_KEY=edu-insecure-production-grade-secret-key-change-in-production!
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Organization & Multitenancy
DEFAULT_ORG_SLUG=default-school

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres@db:5432/edu_platform_db

# Redis (Cache, Rate Limiting, Celery Broker)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# S3 / MinIO Storage
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=edu-materials
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# YouTube Data API Key (Optional)
YOUTUBE_API_KEY=

# 2FA Fernet Secret Key (32-byte url-safe base64 key)
TWO_FACTOR_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZmVybmV0LWtleS0xMjM=

# Feature Flags
FEATURE_PAYMENTS_ENABLED=True
FEATURE_GOOGLE_OAUTH_ENABLED=False
FEATURE_CAPTCHA_ENABLED=False

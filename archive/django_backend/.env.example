# Django Secret Key (Generate a random 50+ chars string for production)
SECRET_KEY=django-insecure-change-me-to-a-super-secret-random-key-in-production

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated list)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Allowed Origins (comma-separated list for frontend clients)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database configuration (Defaults to SQLite if DB_ENGINE not set)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=django_jwt_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=db
# DB_PORT=5432

# JWT Signing Key (Optional, uses SECRET_KEY if left blank)
JWT_SECRET_KEY=

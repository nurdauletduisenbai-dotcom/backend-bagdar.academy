# Продакшен-настройки bagdar.academy. На сервере лежит в edu_platform/.env (chmod 600, в git не попадает).
# setup.sh создаёт этот файл сам при первом запуске и генерирует секреты; шаблон — для справки.

# ---------- Django ----------
DJANGO_SECRET_KEY=__generated__
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=bagdar.academy,www.bagdar.academy,10.42.0.23,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://bagdar.academy,https://www.bagdar.academy
CORS_ALLOWED_ORIGINS=https://bagdar.academy,https://www.bagdar.academy
# False, пока нет сертификата; `setup.sh ssl` переключает в True
DJANGO_SECURE_SSL_REDIRECT=False
DEFAULT_ORG_SLUG=fizmat-school
FRONTEND_URL=https://bagdar.academy
DJANGO_STATIC_ROOT=/var/www/bagdar.academy/static
DJANGO_MEDIA_ROOT=/var/lib/bagdar/media

# ---------- PostgreSQL (локальный, на этом же сервере) ----------
DATABASE_URL=postgres://bagdar:__generated__@127.0.0.1:5432/bagdar

# ---------- Redis (локальный) ----------
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---------- Почта (пусто — письма пишутся в journalctl -u bagdar-backend) ----------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@bagdar.academy

# ---------- Интеграции ----------
YOUTUBE_API_KEY=
TWO_FACTOR_ENCRYPTION_KEY=__generated__
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAX_UPLOAD_SIZE_MB=20

# ---------- Feature flags ----------
FEATURE_PAYMENTS_ENABLED=True
FEATURE_GOOGLE_OAUTH_ENABLED=False
FEATURE_CAPTCHA_ENABLED=False

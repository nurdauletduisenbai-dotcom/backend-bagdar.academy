# Скопируйте в .env:  cp .env.example .env
# Этот файл читают docker-compose и Django (при запуске backend без Docker).
# Адреса сервисов ниже — для локального запуска без Docker; в Docker они
# переопределяются в docker-compose.yml (db, redis, mailhog).

# ---------- Django ----------
DJANGO_SECRET_KEY=edu-insecure-dev-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Организация для публичной регистрации (slug) и адрес фронтенда для ссылок в письмах
DEFAULT_ORG_SLUG=fizmat-school
FRONTEND_URL=http://localhost:5173

# ---------- PostgreSQL ----------
POSTGRES_DB=edu_platform_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edu_platform_db

# ---------- Redis (кэш, лимит входов, брокер Celery) ----------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- Почта (в Docker — MailHog, UI: http://localhost:8025) ----------
EMAIL_HOST=
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=noreply@edu.local

# ---------- Порты на хосте ----------
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---------- Интеграции ----------
YOUTUBE_API_KEY=
# 2FA Fernet key (32-byte url-safe base64)
TWO_FACTOR_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZmVybmV0LWtleS0xMjM=

# Stripe (тестовые ключи: dashboard.stripe.com/test/apikeys). Пусто — оплата картой отключена.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Максимальный размер загружаемых файлов, МБ
MAX_UPLOAD_SIZE_MB=20

# ---------- Feature flags ----------
FEATURE_PAYMENTS_ENABLED=True
FEATURE_GOOGLE_OAUTH_ENABLED=False
FEATURE_CAPTCHA_ENABLED=False

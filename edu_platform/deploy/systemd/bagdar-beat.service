[Unit]
Description=bagdar.academy — Celery beat (периодические задачи)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
User=nur
Group=nur
WorkingDirectory=/home/nur/apps/backend-bagdar.academy/edu_platform/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
StateDirectory=bagdar
ExecStart=/home/nur/apps/backend-bagdar.academy/venv/bin/celery -A config beat -l info \
    --schedule /var/lib/bagdar/celerybeat-schedule
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
